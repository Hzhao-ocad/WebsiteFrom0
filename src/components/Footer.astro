---
// src/components/Footer.astro
import { SOCIAL_LINKS } from "../lib/site";
// Only real, configured profile URLs are rendered — see src/lib/site.ts.
// TODO(owner): add your handles in SOCIAL_LINKS to make these icons appear.
const { instagram, tiktok, youtube } = SOCIAL_LINKS;
---

<footer class="main-footer">
  <div class="footer-container">
    <div class="socials">
      {instagram && (
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Harry Zhao on Instagram" title="Instagram" class="social-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
      )}
      {tiktok && (
        <a href={tiktok} target="_blank" rel="noopener noreferrer" aria-label="Harry Zhao on TikTok" title="TikTok" class="social-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M19.6 6.7a5.4 5.4 0 0 1-3.2-1.1 5.4 5.4 0 0 1-2.1-3.2h-3.2v13.1a2.7 2.7 0 1 1-1.9-2.6V9.6a5.9 5.9 0 1 0 5.1 5.9V9.2a8.5 8.5 0 0 0 5.3 1.8z" />
          </svg>
        </a>
      )}
      {youtube && (
        <a href={youtube} target="_blank" rel="noopener noreferrer" aria-label="Harry Zhao on YouTube" title="YouTube" class="social-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.5 12 4.5 12 4.5s-7 0-8.9.6A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.6 8.9.6 8.9.6s7 0 8.9-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.2zM9.8 15.5v-7l6.2 3.5z" />
          </svg>
        </a>
      )}
      <a href="/contact" aria-label="Email Harry Zhao" title="Email" class="social-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>
    </div>
    <p class="copyright">&copy; 2026 Harry Zhao. All rights reserved.</p>
  </div>
</footer>

<style>
  .main-footer {
    width: 100%;
    margin-top: 4rem;
    padding: 2rem 1.125rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .socials {
    display: flex;
    gap: 1.5rem;
  }

  .social-icon {
    color: rgba(255, 255, 255, 0.65);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .social-icon:hover {
    color: #fbbf24;
    transform: translateY(-2px);
  }

  .copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    margin: 0;
    text-align: center;
  }
</style>
