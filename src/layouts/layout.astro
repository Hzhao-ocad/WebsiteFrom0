---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export interface Props {
  title?: string
}
export let title: string = "Harry Zhao - Portfolio"

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">.

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root { --bg1: #111111; --bg2: #1c1c1c; --fg: #f5f5f5; --accent: #fbbf24; --heading-font: "DM Serif Display", serif;}
      html, body { height: 100%; margin: 0; }
      /* Apply the new font only to headings */
      h1, h2, h3, .section-heading {
        font-family: var(--heading-font);
        font-weight: 400; /* DM Serif Display usually only has weight 400 */
      }
      body {
        min-height: 100vh;
        display: block;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: var(--bg1);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      }
      .container {
        text-align: center;
        padding: 2rem;
        border-radius: 12px;
        max-width: 880px;
        width: 90%;
        margin: 0 auto;
      }
      h1 { margin: 0 0 0.5rem 0; font-size: clamp(1.5rem, 4vw, 2.5rem); }
      p { margin: 0; opacity: 0.9; }
    </style>
  </head>
  <body>
    <Header />
    
    <main>
      <slot /> </main>
    <Footer />
  </body>
</html>
