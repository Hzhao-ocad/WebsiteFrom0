---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export interface Props {
  title?: string
}
export let title: string = "Harry Zhao - Portfolio"

const isPreview = Astro.url.searchParams.get('preview') === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://player.vimeo.com">
    <link rel="preconnect" href="https://i.vimeocdn.com" crossorigin>
    <link rel="preconnect" href="https://f.vimeocdn.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">.

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root { --bg1: #111111; --bg2: #1c1c1c; --fg: #f5f5f5; --accent: #fbbf24; --heading-font: "DM Serif Display", serif; --header-height: 24px;}
      html, body { height: 100%; margin: 0; }
      /* Apply the new font only to headings */
      h1, h2, h3, .section-heading {
        font-family: var(--heading-font);
        font-weight: 400; /* DM Serif Display usually only has weight 400 */
      }
      body {
        min-height: 100vh;
        display: block;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: var(--bg1);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      }
      .container {
        text-align: center;
        padding: 2rem;
        border-radius: 12px;
        max-width: 880px;
        width: 90%;
        margin: 0 auto;
      }
      h1 { margin: 0 0 0.5rem 0; font-size: clamp(1.5rem, 4vw, 2.5rem); }
      p { margin: 0; opacity: 0.9; }
      .to-top {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        padding: 0.6rem 0.9rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.6);
        color: var(--fg);
        text-decoration: none;
        font-size: 0.9rem;
        letter-spacing: 0.03em;
        border: 1px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(6px);
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease, border 0.2s ease;
        z-index: 10;
      }
      .to-top.is-visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      .to-top:hover {
        transform: translateY(-2px);
        background: rgba(0, 0, 0, 0.75);
        border-color: rgba(255, 255, 255, 0.4);
      }
      .to-top:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <div id="top"></div>
    <Header />
    
    <main>
      <slot /> </main>
    <Footer />
    <a class="to-top" href="#top" aria-label="Return to top">Top</a>
    {isPreview && (
      <script>
        import { enableVisualEditing } from '@sanity/visual-editing';
        enableVisualEditing({
          refresh: (payload) => {
            if (payload.source === 'mutation') {
              window.location.reload();
              return new Promise(() => {});
            }
            return false;
          },
        });
      </script>
    )}
    <script>
      const toTopButton = document.querySelector(".to-top");
      const toggleToTop = () => {
        if (!toTopButton) return;
        if (window.scrollY > 200) {
          toTopButton.classList.add("is-visible");
        } else {
          toTopButton.classList.remove("is-visible");
        }
      };
      toggleToTop();
      window.addEventListener("scroll", toggleToTop, { passive: true });

      const header = document.querySelector<HTMLElement>(".main-header");
      const syncHeaderHeight = () => {
        if (!header) return;
        document.documentElement.style.setProperty(
          "--header-height",
          header.offsetHeight + "px"
        );
      };
      syncHeaderHeight();
      window.addEventListener("resize", syncHeaderHeight);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(syncHeaderHeight);
      }
    </script>
  </body>
</html>
