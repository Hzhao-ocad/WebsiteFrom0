---
import Layout from "../../layouts/layout.astro";
import { getAllBlogSlugs, getBlogPostBySlug, getTextStyles } from "../../lib/queries";
import { urlFor, previewClient } from "../../lib/sanityClient";
import { toHTML } from "@portabletext/to-html";

const isPreview = Astro.url.searchParams.get('preview') === '1';

export async function getStaticPaths() {
  const slugs = await getAllBlogSlugs();
  return slugs.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug as string, isPreview ? previewClient : undefined);

if (!post) {
  return Astro.redirect('/blog');
}

const title = `${post.title} - Harry Zhao Blog`;
const heroImageUrl = urlFor(post.heroImage).width(1600).url();

const textStyles = await getTextStyles();
const styleVarMap: Record<string, string> = {
  small: '--text-color-small',
  normal: '--text-color-normal',
  h4: '--text-color-h4',
  h3: '--text-color-h3',
  h2: '--text-color-h2',
  h1: '--text-color-h1',
  blockquote: '--text-color-blockquote',
  link: '--text-color-link',
};
const bodyStyleAttr = textStyles
  ? Object.entries(textStyles)
      .filter(([, v]) => typeof v === 'string' && v.length > 0)
      .map(([k, v]) => `${styleVarMap[k]}: ${v};`)
      .join(' ')
  : '';

const buildBlockClassFromStyle = (style: string, extraClasses: string[] = []) => {
  const align = style.includes('-') ? style.split('-')[1] : 'left';
  return ['body-text', `align-${align}`, ...extraClasses].filter(Boolean).join(' ');
};

const blockComponents: Record<string, ({ children }: { children?: string }) => string> = {};

const addBlockStyle = (style: string, tag: string, extraClasses: string[] = []) => {
  blockComponents[style] = ({ children }) =>
    `<${tag} class="${buildBlockClassFromStyle(style, extraClasses)}">${children ?? ''}</${tag}>`;
};

const sizes = ['normal', 'small', 'h1', 'h2', 'h3', 'h4'] as const;
const aligns = ['left', 'center', 'right'] as const;
const tagForSize: Record<(typeof sizes)[number], string> = {
  normal: 'p',
  small: 'p',
  h1: 'h1',
  h2: 'h2',
  h3: 'h3',
  h4: 'h4',
};

sizes.forEach((size) => {
  addBlockStyle(size, tagForSize[size], size === 'small' ? ['text-small'] : []);
  aligns
    .filter((align) => align !== 'left')
    .forEach((align) => {
      addBlockStyle(`${size}-${align}`, tagForSize[size], size === 'small' ? ['text-small'] : []);
    });
});

addBlockStyle('blockquote', 'blockquote', ['body-quote']);

const bodyHtml = post.body
  ? toHTML(post.body as any, {
      components: {
        types: {
          imageBlock: ({ value }: { value: any }) => {
            if (!value.asset) {
              console.warn('imageBlock missing asset:', value);
              return '';
            }
            const widthOption = (value.width as string) ?? 'text';
            const customWidth = (value.customWidth as string | undefined)?.trim();
            const renderWidth = ({
              small: 600,
              text: 1000,
              medium: 1300,
              large: 1800,
              full: 2400,
              custom: 2400,
            } as Record<string, number>)[widthOption] ?? 1000;

            const customStyle =
              widthOption === 'custom' && customWidth
                ? ` style="--custom-image-width: ${customWidth};"`
                : '';

            const src = value.asset.url
              ? `${value.asset.url}?w=${renderWidth}&auto=format`
              : value.asset._ref
                ? urlFor(value).width(renderWidth).url()
                : null;

            if (!src) {
              console.warn('imageBlock has no valid asset url or ref:', value);
              return '';
            }

            const alt = value.caption ?? post.title;
            const caption = value.caption
              ? `<figcaption class="image-caption">${value.caption}</figcaption>`
              : '';
            return `<section class="fullwidth-image-section image-width-${widthOption}"${customStyle}><figure><img src="${src}" alt="${alt}" class="fullwidth-image" loading="lazy" />${caption}</figure></section>`;
          },
        },
        block: blockComponents,
        listItem: ({ children, value }: { children?: string; value?: any }) => {
          const level = Number(value?.level) || 1;
          return `<li data-level="${level}">${children}</li>`;
        },
        marks: {
          link: ({ children, value }: { children?: string; value?: any }) =>
            `<a href="${value?.href ?? ''}" target="_blank" rel="noopener noreferrer">${children ?? ''}</a>`,
        },
      },
    })
  : '';
---

<Layout title={title} bodyClass="blog-theme">
  <!-- Hero Section -->
  <section class="blog-hero">
    <div class="blog-hero-image-wrapper">
      <img
        src={heroImageUrl}
        alt={post.title}
        class="blog-hero-image"
        fetchpriority="high"
      />
      <div class="blog-hero-overlay"></div>
    </div>
    <div class="blog-hero-content">
      <div class="blog-hero-meta">
        <time datetime={post.publishDate}>
          {new Date(post.publishDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.tags && post.tags.length > 0 && (
          <div class="blog-hero-tags">
            {post.tags.map((tag) => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      <h1 class="blog-hero-title">{post.title}</h1>
    </div>
  </section>

  <!-- Body Content -->
  {bodyHtml && (
    <div class="blog-body" style={bodyStyleAttr} set:html={bodyHtml} />
  )}

  <!-- Back to blog -->
  <div class="blog-back">
    <a href="/blog">&larr; Back to Blog</a>
  </div>
</Layout>

<style>
  /* --- Hero --- */
  .blog-hero {
    position: relative;
    width: 100%;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .blog-hero-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .blog-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .blog-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 22, 40, 0.95) 0%,
      rgba(10, 22, 40, 0.6) 40%,
      rgba(10, 22, 40, 0.2) 100%
    );
  }

  .blog-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 3rem;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }

  .blog-hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .blog-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }

  .blog-tag {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.15);
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .blog-hero-title {
    font-family: var(--heading-font);
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 400;
    color: var(--fg);
    margin: 0;
    line-height: 1.2;
  }

  /* --- Body content --- */
  .blog-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
  }

  .blog-body :global(.body-text) {
    margin: 0 0 1.5rem;
  }

  .blog-body :global(.body-quote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    margin: 2rem 0;
  }

  .blog-body :global(.fullwidth-image-section) {
    margin: 2.5rem 0;
  }

  .blog-body :global(.fullwidth-image-section figure) {
    margin: 0;
  }

  .blog-body :global(.fullwidth-image) {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }

  .blog-body :global(.image-caption) {
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 0.5rem;
  }

  .blog-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .blog-body :global(h1), .blog-body :global(h2), .blog-body :global(h3), .blog-body :global(h4) {
    font-family: var(--heading-font);
    font-weight: 400;
    color: var(--fg);
    margin: 2rem 0 0.75rem;
  }

  .blog-body :global(ul), .blog-body :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.5rem;
  }

  .blog-body :global(li) {
    margin-bottom: 0.4rem;
  }

  /* --- Back link --- */
  .blog-back {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }

  .blog-back a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .blog-back a:hover {
    color: var(--accent);
  }

  /* --- Image width variants --- */
  :global(.image-width-small) { max-width: 480px; margin-left: auto; margin-right: auto; }
  :global(.image-width-text) { max-width: 800px; margin-left: auto; margin-right: auto; }
  :global(.image-width-medium) { max-width: 1000px; margin-left: auto; margin-right: auto; }
  :global(.image-width-large) { max-width: 1400px; margin-left: auto; margin-right: auto; }
  :global(.image-width-full) { max-width: 100%; }
</style>
