---
import Layout from "../../layouts/layout.astro";
import { getAllBlogPosts } from "../../lib/queries";
import { urlFor } from "../../lib/sanityClient";

const title = "Blog - Harry Zhao";
const posts = await getAllBlogPosts();
---

<Layout title={title} bodyClass="blog-theme">
  <section class="blog-listing" id="blog-listing">
    <!-- Left: Title list -->
    <aside class="blog-sidebar">
      <h2 class="blog-sidebar-title">Posts</h2>
      <nav class="blog-nav">
        {posts.map((post, i) => (
          <button
            class="blog-nav-item"
            data-index={i}
            class:list={[{ active: i === 0 }]}
          >
            <span class="blog-nav-date">
              {new Date(post.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
            </span>
            <span class="blog-nav-title">{post.title}</span>
          </button>
        ))}
      </nav>
      <a href="/blog/rss.xml" class="rss-link" title="RSS Feed">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
        </svg>
        RSS
      </a>
    </aside>

    <!-- Center: Content preview -->
    <main class="blog-preview">
      {posts.map((post, i) => (
        <article
          class="blog-preview-card"
          data-index={i}
          class:list={[{ active: i === 0 }]}
        >
          <div class="blog-preview-meta">
            <time datetime={post.publishDate}>
              {new Date(post.publishDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.tags && post.tags.length > 0 && (
              <div class="blog-preview-tags">
                {post.tags.map((tag) => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <h2 class="blog-preview-title">
            <a href={`/blog/${post.slug.current}`}>{post.title}</a>
          </h2>
          <p class="blog-preview-excerpt">{post.excerpt}</p>
          <a href={`/blog/${post.slug.current}`} class="blog-read-more">
            Read more &rarr;
          </a>
        </article>
      ))}
    </main>

    <!-- Right: Thumbnail -->
    <aside class="blog-thumbnails">
      {posts.map((post, i) => (
        <a
          href={`/blog/${post.slug.current}`}
          class="blog-thumbnail-wrapper"
          data-index={i}
          class:list={[{ active: i === 0 }]}
        >
          <img
            src={urlFor(post.heroImage).width(400).height(300).fit('crop').url()}
            alt={post.title}
            class="blog-thumbnail"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </aside>
  </section>
</Layout>

<script>
  // Interactive blog listing: clicking a title in the sidebar updates the preview and thumbnail
  const navItems = document.querySelectorAll<HTMLButtonElement>('.blog-nav-item');
  const previewCards = document.querySelectorAll<HTMLElement>('.blog-preview-card');
  const thumbnails = document.querySelectorAll<HTMLElement>('.blog-thumbnail-wrapper');

  function activateIndex(index: number) {
    navItems.forEach((el) => {
      el.classList.toggle('active', Number(el.dataset.index) === index);
    });
    previewCards.forEach((el) => {
      el.classList.toggle('active', Number(el.dataset.index) === index);
    });
    thumbnails.forEach((el) => {
      el.classList.toggle('active', Number(el.dataset.index) === index);
    });
  }

  navItems.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateIndex(Number(btn.dataset.index));
    });
    btn.addEventListener('mouseenter', () => {
      activateIndex(Number(btn.dataset.index));
    });
  });

  // Keyboard navigation within the sidebar
  const sidebar = document.querySelector<HTMLElement>('.blog-nav');
  sidebar?.addEventListener('keydown', (e) => {
    const current = Array.from(navItems).findIndex((el) => el === document.activeElement);
    if (current === -1) return;
    let next = current;
    if (e.key === 'ArrowDown') next = Math.min(current + 1, navItems.length - 1);
    else if (e.key === 'ArrowUp') next = Math.max(current - 1, 0);
    else return;
    e.preventDefault();
    (navItems[next] as HTMLButtonElement).focus();
    activateIndex(next);
  });
</script>

<style>
  .blog-listing {
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    min-height: calc(100vh - 200px);
  }

  @media (max-width: 1024px) {
    .blog-listing {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .blog-thumbnails { display: none; }
    .blog-sidebar {
      position: sticky;
      top: 0;
      z-index: 5;
      background: var(--bg1);
      padding-bottom: 0.5rem;
    }
    .blog-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      overflow-x: auto;
    }
    .blog-nav-item {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }

  /* --- Left sidebar --- */
  .blog-sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding-right: 1rem;
  }

  .blog-sidebar-title {
    font-family: var(--heading-font);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .blog-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .blog-nav-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    padding: 0.45rem 0.5rem;
    border-radius: 6px;
    text-align: left;
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
    width: 100%;
    font-family: inherit;
  }

  .blog-nav-item:hover,
  .blog-nav-item:focus-visible,
  .blog-nav-item.active {
    background: rgba(255, 255, 255, 0.06);
    color: var(--fg);
  }

  .blog-nav-item.active {
    color: var(--accent);
  }

  .blog-nav-date {
    font-size: 0.75rem;
    opacity: 0.5;
    flex-shrink: 0;
    min-width: 2.5rem;
  }

  .blog-nav-title {
    line-height: 1.3;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .rss-link:hover {
    color: var(--accent);
  }

  /* --- Center preview --- */
  .blog-preview {
    position: relative;
  }

  .blog-preview-card {
    display: none;
    animation: fadeSlideIn 0.25s ease;
  }

  .blog-preview-card.active {
    display: block;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .blog-preview-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .blog-preview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .blog-tag {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.12);
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .blog-preview-title {
    font-family: var(--heading-font);
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }

  .blog-preview-title a {
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s;
  }

  .blog-preview-title a:hover {
    color: var(--accent);
  }

  .blog-preview-excerpt {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .blog-read-more {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: gap 0.2s;
  }

  .blog-read-more:hover {
    text-decoration: underline;
  }

  /* --- Right thumbnails --- */
  .blog-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-thumbnail-wrapper {
    display: none;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .blog-thumbnail-wrapper.active {
    display: block;
  }

  .blog-thumbnail-wrapper:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .blog-thumbnail {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
</style>
