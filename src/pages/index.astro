---
import Layout from "../layouts/layout.astro";
import Footer from "../components/Footer.astro";
import { getFeaturedWorks, type SanityWork } from '../lib/queries';
import { urlFor } from '../lib/sanityClient';
import { SITE_URL, SITE_NAME, personSchema } from '../lib/site';

const title = "Harry Zhao — Artist & Physical Computing / Robotics (Toronto)";
const description = "Harry Zhao is a Toronto-based artist and researcher building Iterative Creatures — robots with their own agency. Physical computing, interactive installation, digital media.";

// Get featured works from Sanity, with a manually curated lead-in order
const featuredWorks = await getFeaturedWorks();
const FEATURED_ORDER = ['aworm', 'echoes-of-you', 'pet-network', 'comet-rat', 'light-touch'];
const orderedFeaturedWorks = [
  ...FEATURED_ORDER.map(slug => featuredWorks.find(work => work.slug.current === slug)).filter((work): work is SanityWork => work !== undefined),
  ...featuredWorks.filter(work => !FEATURED_ORDER.includes(work.slug.current)),
];

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  description,
  publisher: { '@id': personSchema['@id'] },
};
---

<Layout title={title} description={description} jsonLd={[personSchema, websiteSchema]} showFooter={false}>
  <section class="full-section video-bg">
    <div class="bg-video-wrapper">
      <picture>
        <source srcset="/images/hero-poster.webp" type="image/webp" />
        <img
          class="bg-poster"
          src="/images/hero-poster.jpg"
          alt=""
          aria-hidden="true"
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </picture>
      <iframe
        class="bg-video"
        src="https://player.vimeo.com/video/1193420841?background=1&autoplay=1&loop=1&muted=1&autopause=0&dnt=1"
        allow="autoplay; fullscreen"
        allowfullscreen
        loading="eager"
        title="Hero background"
        onload="this.classList.add('is-ready')"
      ></iframe>
    </div>
    <div class="content-wrapper container">
      <div class="hero">
        <h1>Harry Zhao</h1>
        <p class="hero-subtitle">Physical Computing | Digital Media</p>
      </div>
    </div>
  </section>

  <section class="full-section section black-bg" style={{ "--bg-color": `url('/images/work/moomoocow/moomoocow_2.png')` }}>

    <ul class="works-list">
      {orderedFeaturedWorks.map((work, index) => {
        const year = work.publishDate ? new Date(work.publishDate).getFullYear() : null;
        return (
          <li class={`work-row ${index === 0 ? 'work-row--default' : ''}`}>
            <div class="work-media">
              <a href={`/works/${work.slug.current}`} class="work-media-link" tabindex="-1">
                <img src={urlFor(work.coverImage).width(1600).url()} alt="" loading="lazy" width="1600" height="1200" />
                {work.previewVideoUrl && (
                  <video muted loop autoplay preload="none">
                    <source src={work.previewVideoUrl} type="video/webm" />
                  </video>
                )}
              </a>
            </div>
            <a href={`/works/${work.slug.current}`} class="work-title">
              {work.title}
              {year && <span class="work-year"> — {year}</span>}
            </a>
          </li>
        );
      })}
    </ul>

    <Footer />
  </section>


</Layout>

<script>
  // Assist the hero -> featured-works transition: mostly free scroll, but
  // if the user stops scrolling within the top/bottom ~20% of that first
  // screen, finish carrying them to the nearest section edge.
  (() => {
    const SNAP_THRESHOLD = 0.8;
    const sections = document.querySelectorAll<HTMLElement>('.full-section');
    const heroSection = sections[0];
    if (!heroSection || sections.length < 2) return;

    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

    let scrollEndTimer: number | undefined;
    let isAssisting = false;

    const handleScrollEnd = () => {
      if (isAssisting || isMobile()) return;

      const heroHeight = heroSection.offsetHeight;
      const scrollY = window.scrollY;
      if (scrollY <= 0 || scrollY >= heroHeight) return;

      const progress = scrollY / heroHeight;
      let target: number | null = null;
      if (progress >= SNAP_THRESHOLD) {
        target = heroHeight;
      } else if (progress <= 1 - SNAP_THRESHOLD) {
        target = 0;
      }
      if (target === null) return;

      isAssisting = true;
      window.scrollTo({ top: target, behavior: 'smooth' });
      window.setTimeout(() => { isAssisting = false; }, 600);
    };

    window.addEventListener('scroll', () => {
      if (isAssisting) return;
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(handleScrollEnd, 150);
    }, { passive: true });
  })();
</script>

<style>
.works-list {
  list-style: none;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  width: 100%;
  max-width: 900px;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: center;
}

.work-row {
  text-align: center;
  padding: 0.3rem 0;
}

.work-media {
  position: absolute;
  inset: 0;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.6s ease;
  pointer-events: none;
  z-index: 0;
  background: var(--bg1);
}

.work-row:hover .work-media {
  opacity: 1;
}

.works-list:not(:hover) .work-row--default .work-media {
  opacity: 1;
}

.work-media-link {
  display: block;
  width: 100%;
  height: 100%;
}

.work-media img,
.work-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.work-media video {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.work-row:hover .work-media video {
  opacity: 1;
}

.works-list:not(:hover) .work-row--default .work-media video {
  opacity: 1;
}

.work-title {
  position: relative;
  z-index: 2;
  display: inline-block;
  text-decoration: none;
  color: var(--fg);
  font-family: "DM Serif Display", serif;
  font-size: 1.75rem;
  transition: color 0.2s ease;
}

.work-row:hover .work-title {
  color: #fbbf24;
}

.works-list:not(:hover) .work-row--default .work-title {
  color: #fbbf24;
}

.work-year {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.5);
}

@media (max-width: 768px) {
  .work-row {
    padding: 0.5rem 0;
  }
  .work-media {
    display: none;
  }
  .black-bg::before {
    display: none;
  }
  .work-title {
    font-size: 1.35rem;
  }
  .full-section {
    min-height:0;
  }
}

  .img-bg {
    background: var(--bg-url) center / cover no-repeat;
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
  .video-bg {
    overflow: hidden;
    color: white;
    box-sizing: border-box;
    padding-top: var(--header-height);
  }
  .bg-video-wrapper {
    position: absolute;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    background: var(--bg1);
  }
  .bg-poster {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-width: 177.78vh;
    min-height: calc(100vh - var(--header-height));
    transform: translateX(-50%);
    object-fit: cover;
    z-index: 0;
  }
  .bg-video {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-width: 177.78vh;
    min-height: calc(100vh - var(--header-height));
    transform: translateX(-50%);
    border: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 1;
  }
  .bg-video.is-ready {
    opacity: 1;
  }
  .video-bg .content-wrapper {
    z-index: 1;
  }
  .black-bg{
    overflow-x: hidden;
    background: var(--bg-color) center / cover no-repeat;
  }
  .black-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
    pointer-events: none;
  }
  .black-bg :global(.main-footer) {
    position: relative;
    z-index: 2;
    margin-top: auto;
  }
  .full-section {
    position: relative;
    height: auto;
    min-height: 100vh;
	  width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    flex-direction: column;
  }
  .short-section {
    min-height: 50vh;
    align-items: center;
    justify-content: center;
  }
  .content-wrapper {
    position: relative;
    align-items: center;
    justify-content: center;
    display: flex;
    flex: 1;
    width: 100%;
  }

  .section {
	color: var(--fg);
  }
  .about-text { 
    padding: 0 10rem 0 10rem;
    
  }

  @media (max-width: 768px) {
  .about-text {
    padding: 0 1rem 0 1rem; /* much more reasonable for mobile */
  }
}


  .hero {
    text-align: center;
    font-family: "DM Serif Display", serif;
    font-size: 2.2rem;
  }

  .hero h1 {
    font-size: 6.2rem;
    font-weight: 300;
    margin-bottom: var(--spacing-sm);
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    margin-left: auto; 
    margin-right: auto;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .section-heading { 
    margin:0 0.75rem 0; 
    font-size: 3rem; 
    font-family: "DM Serif Display", serif; 
    display:flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
  .muted {
    color: rgba(255,255,255,0.4);
  }

  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
</style>
