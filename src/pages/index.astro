---
import Layout from "../layouts/layout.astro";
const title = "Harry Zhao - Portfolio";

import { getFeaturedWorks } from '../lib/queries';
import { urlFor } from '../lib/sanityClient';

// Get featured works from Sanity
const featuredWorks = await getFeaturedWorks();
const top6FeaturedWorks = featuredWorks.sort(() => Math.random() - 0.5).slice(0, 8);
---

<Layout title={title}>
  <section class="full-section video-bg">
    <div class="bg-video-wrapper">
      <iframe
        class="bg-video"
        src="https://player.vimeo.com/video/1193420841?background=1&autoplay=1&loop=1&muted=1&autopause=0&dnt=1"
        allow="autoplay; fullscreen"
        allowfullscreen
        title="Hero background"
      ></iframe>
    </div>
    <div class="content-wrapper container">
      <div class="hero">
        <h1>Harry Zhao</h1>
        <p class="hero-subtitle">Physical Computing | Digital Media</p>
      </div>
    </div>
  </section>

  <section class="full-section section black-bg" style={{ "--bg-color": `url('/images/work/moomoocow/moomoocow_2.png')` }}>

    <div class="card-wrapper">
      {top6FeaturedWorks.map(work => (
      <a href={`/works/${work.slug.current}`} class="card">
        <img src={urlFor(work.coverImage).width(800).url()} alt={work.title} class="card_image"/>
        {work.previewVideoUrl && (
        <video muted loop autoplay preload="none">
          <source src={work.previewVideoUrl} type="video/webm" />
        </video>
        )}
        <h3 class="card-info">{work.title}</h3>
      </a>
      ))}
    </div>

  </section>


</Layout>

<style>
.card-wrapper {
  display: grid;
  grid-template-rows: auto;
  grid-template-columns: repeat(4, 1fr);
  width: 100%;
}

@media (max-width: 768px) {
  .card-wrapper {
    /* 2 columns for mobile */
    grid-template-columns: repeat(2, 1fr);
  }
  .full-section {
    min-height:0;
  }
}

.card {
  position:relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  width:  auto;
  height: auto;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  }
  
.card_image
{
  width: 100%;
  height: 100%;
  object-fit: cover;

}

.card video{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:hover video{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 0.3s ease;
}
  
.card-info {
  position: absolute;
  bottom: 0;
  margin-bottom: 0;
  align-items: bottom;
  width: 100%;
  text-align: right;
  font-size: 1.25rem;
  color: white;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
  opacity: 0;
  
  transform: translateY(30px); 
  transition: all 0.3s ease;

}
.card:hover .card-info{
  opacity: 1;
  transform: translateY(0);
}

  .img-bg {
    background: var(--bg-url) center / cover no-repeat;
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
  .video-bg {
    overflow: hidden;
    color: white;
  }
  .bg-video-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-width: 177.78vh;
    min-height: 100vh;
    transform: translate(-50%, -50%);
    border: 0;
  }
  .video-bg .content-wrapper {
    z-index: 1;
  }
  .black-bg{
  }
  .full-section {
    position: relative;
    height: auto;
    min-height: 100vh;
	  width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    flex-direction: column;
  }
  .short-section {
    min-height: 50vh;
    align-items: center;
    justify-content: center;
  }
  .content-wrapper {
    position: relative;
    align-items: center;
    justify-content: center;
    display: flex;
    flex: 1;
    width: 100%;
  }

  .section {
	color: var(--fg);
  }
  .about-text { 
    padding: 0 10rem 0 10rem;
    
  }

  @media (max-width: 768px) {
  .about-text {
    padding: 0 1rem 0 1rem; /* much more reasonable for mobile */
  }
}


  .hero {
    text-align: center;
    font-family: "DM Serif Display", serif;
    font-size: 2.2rem;
  }

  .hero h1 {
    font-size: 6.2rem;
    font-weight: 300;
    margin-bottom: var(--spacing-sm);
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    margin-left: auto; 
    margin-right: auto;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .section-heading { 
    margin:0 0.75rem 0; 
    font-size: 3rem; 
    font-family: "DM Serif Display", serif; 
    display:flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
  .muted {
    color: rgba(255,255,255,0.4);
  }

  ul { text-align: left; max-width: 560px; margin: 0 auto; }


  .section-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
</style>
