---
import Layout from "../../layouts/layout.astro";
import { getAllWorkSlugs, getWorkBySlug } from "../../lib/queries";
import { urlFor } from "../../lib/sanityClient";
import { toHTML } from "@portabletext/to-html";

export async function getStaticPaths() {
  const slugs = await getAllWorkSlugs();
  return slugs.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const work = await getWorkBySlug(slug as string);

if (!work) {
  return Astro.redirect('/works');
}

const title = `${work.title} - Harry Zhao`;
const heroImageUrl = urlFor(work.coverImage).width(1600).url();

// Render body blocks to HTML
const bodyHtml = work.body
  ? toHTML(work.body as any, {
      components: {
        types: {
          imageBlock: ({ value }: { value: any }) => {
            // Handle cases where asset is missing or null
            if (!value.asset) {
              console.warn('imageBlock missing asset:', value);
              return '';
            }

            // Use dereferenced url if available, otherwise use urlFor with the reference
            const src = value.asset.url
              ? `${value.asset.url}?w=1200&auto=format`
              : value.asset._ref
                ? urlFor(value).width(1200).url()
                : null;

            if (!src) {
              console.warn('imageBlock has no valid asset url or ref:', value);
              return '';
            }

            const alt = value.caption ?? work.title;
            const caption = value.caption
              ? `<figcaption class="image-caption">${value.caption}</figcaption>`
              : '';
            return `<section class="fullwidth-image-section"><figure><img src="${src}" alt="${alt}" class="fullwidth-image" />${caption}</figure></section>`;
          },
          videoEmbed: ({ value }: { value: any }) => {
            const embedUrl = value.url.replace('watch?v=', 'embed/');
            return `<section class="body-video-section"><div class="video-wrapper"><iframe src="${embedUrl}" title="${work.title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div></section>`;
          },
        },
        block: {
          normal: ({ children }: { children?: string }) => `<p>${children ?? ''}</p>`,
          h2: ({ children }: { children?: string }) => `<h2>${children ?? ''}</h2>`,
          h3: ({ children }: { children?: string }) => `<h3>${children ?? ''}</h3>`,
        },
        marks: {
          link: ({ children, value }: { children: string; value?: any }) =>
            `<a href="${value?.href}" target="_blank" rel="noopener noreferrer">${children}</a>`,
        },
      },
    })
  : '';
---

<Layout title={title}>
  <!-- Hero Section -->
  <section class="hero-section" style={`background-image: url('${heroImageUrl}');`}>
    <div class="hero-overlay"></div>
    <h1 class="hero-title">{work.title}</h1>

    {work.videoUrl ? (
      <div class="video-container">
        <div class="video-wrapper">
          <iframe
            src={work.videoUrl.replace('watch?v=', 'embed/')}
            title={work.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    ) : (
      <div class="hero-content">
        <div class="video-container">
          <img
            src={urlFor(work.coverImage).width(1000).url()}
            alt={work.title}
            class="hero-image"
          />
        </div>
        {work.heroDescription && (
          <div class="hero-text-container">
            <p class="hero-description">{work.heroDescription}</p>
          </div>
        )}
      </div>
    )}
  </section>

  <!-- Collaborators Section -->
  {work.collaborators && work.collaborators.length > 0 && (
    <section class="collaborators-section">
      <p class="collaborators-text">
        In Collaboration with: {
          work.collaborators.map((collab, index) => (
            <>
              {collab.url ? (
                <a href={collab.url} target="_blank" rel="noopener noreferrer" class="collaborator-link">
                  {collab.name}
                </a>
              ) : (
                <span>{collab.name}</span>
              )}
              {index < work.collaborators!.length - 1 && ', '}
            </>
          ))
        }
      </p>
    </section>
  )}

  <!-- Body: text blocks, images, video embeds — in the order you set in Sanity -->
  {bodyHtml && (
    <div class="body-content" set:html={bodyHtml} />
  )}
</Layout>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 100vh;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 15vh;
    background-size: auto;
    background-position: center;
    background-repeat: repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: rgba(0, 0, 0, 0.4);
  }

  .hero-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, #0f172a);
    pointer-events: none;
    z-index: 1;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    font-size: 4rem;
    font-weight: 300;
    text-align: center;
    color: white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .video-container {
    position: relative;
    z-index: 2;
    width: 65vw;
    max-width: 1000px;
    margin-top: 5vh;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 65vw;
    max-width: 1000px;
    margin-top: 5vh;
    display: flex;
    flex-direction: column;
    gap: 3vh;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-text-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-description {
    font-size: 1.5rem;
    line-height: 1.8;
    color: white;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  /* Collaborators Section */
  .collaborators-section {
    width: 100%;
    max-width: 800px;
    margin: 3rem auto 2rem;
    padding: 0 2rem;
  }

  .collaborators-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
  }

  .collaborator-link {
    color: #60a5fa;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .collaborator-link:hover {
    color: #93c5fd;
    text-decoration: underline;
  }

  /* Body content */
  .body-content {
    width: 100%;
  }

  /* Text blocks (rendered from Portable Text) */
  .body-content :global(p),
  .body-content :global(h2),
  .body-content :global(h3) {
    max-width: 800px;
    margin: 0 auto 1.5rem;
    padding: 0 2rem;
    line-height: 1.8;
  }

  .body-content :global(p) {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .body-content :global(h2) {
    font-size: 2rem;
    font-weight: 400;
    margin-top: 3rem;
  }

  .body-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 400;
    margin-top: 2rem;
  }

  .body-content :global(a) {
    color: #60a5fa;
    text-decoration: underline;
  }

  .body-content :global(a:hover) {
    color: #93c5fd;
  }

  /* Image blocks */
  .body-content :global(.fullwidth-image-section) {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .body-content :global(figure) {
    width: 100%;
    max-width: 800px;
    margin: 0;
  }

  .body-content :global(.fullwidth-image) {
    width: 100%;
    height: auto;
    display: block;
  }

  .body-content :global(.image-caption) {
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  /* Video embeds in body */
  .body-content :global(.body-video-section) {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .body-content :global(.body-video-section .video-wrapper) {
    width: 65vw;
    max-width: 1000px;
    position: relative;
    padding-bottom: 56.25%;
  }

  .body-content :global(.body-video-section .video-wrapper iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title { font-size: 2.5rem; }
    .video-container { width: 90vw; }
    .hero-content { width: 90vw; }
    .hero-description { font-size: 1.2rem; }
    .body-content :global(p) { font-size: 1rem; }
    .body-content :global(h2) { font-size: 1.5rem; }
    .body-content :global(h3) { font-size: 1.25rem; }
    .body-content :global(figure) { width: 100%; }
    .body-content :global(.body-video-section .video-wrapper) { width: 90vw; }
  }
</style>
