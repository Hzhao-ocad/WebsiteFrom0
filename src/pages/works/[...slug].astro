---
import Layout from "../../layouts/layout.astro";
import { getAllWorkSlugs, getWorkBySlug } from "../../lib/queries";
import { urlFor } from "../../lib/sanityClient";
import { toHTML } from "@portabletext/to-html";

export async function getStaticPaths() {
  const slugs = await getAllWorkSlugs();
  return slugs.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const work = await getWorkBySlug(slug as string);

if (!work) {
  return Astro.redirect('/works');
}

const title = `${work.title} - Harry Zhao`;
const heroImageUrl = urlFor(work.coverImage).width(1600).url();

// Render body blocks to HTML
const bodyHtml = work.body
  ? toHTML(work.body as any, {
      components: {
        types: {
          imageBlock: ({ value }: { value: any }) => {
            // Handle cases where asset is missing or null
            if (!value.asset) {
              console.warn('imageBlock missing asset:', value);
              return '';
            }

            // Use dereferenced url if available, otherwise use urlFor with the reference
            const src = value.asset.url
              ? `${value.asset.url}?w=1200&auto=format`
              : value.asset._ref
                ? urlFor(value).width(1200).url()
                : null;

            if (!src) {
              console.warn('imageBlock has no valid asset url or ref:', value);
              return '';
            }

            const alt = value.caption ?? work.title;
            const caption = value.caption
              ? `<figcaption class="image-caption">${value.caption}</figcaption>`
              : '';
            return `<section class="fullwidth-image-section"><figure><img src="${src}" alt="${alt}" class="fullwidth-image" />${caption}</figure></section>`;
          },
          imageGallery: ({ value }: { value: any }) => {
            const images = (value.images ?? []).filter((img: any) => img?.asset);
            if (images.length === 0) return '';

            const slides = images
              .map((img: any, i: number) => {
                const src = img.asset.url
                  ? `${img.asset.url}?w=1600&auto=format`
                  : img.asset._ref
                    ? urlFor(img).width(1600).url()
                    : null;
                if (!src) return '';
                const alt = img.caption ?? `${work.title} - image ${i + 1}`;
                const caption = img.caption
                  ? `<figcaption class="image-caption">${img.caption}</figcaption>`
                  : '';
                return `<figure class="gallery-slide" data-index="${i}"${i === 0 ? '' : ' hidden'}><img src="${src}" alt="${alt}" class="fullwidth-image" />${caption}</figure>`;
              })
              .join('');

            return `<section class="fullwidth-image-section gallery-section"><div class="image-gallery" data-count="${images.length}">
              <button type="button" class="gallery-btn gallery-prev" aria-label="Previous image">&#8592;</button>
              <div class="gallery-slides">${slides}</div>
              <button type="button" class="gallery-btn gallery-next" aria-label="Next image">&#8594;</button>
              <div class="gallery-counter"><span class="gallery-current">1</span> / ${images.length}</div>
            </div></section>`;
          },
          videoEmbed: ({ value }: { value: any }) => {
            const embedUrl = value.url.replace('watch?v=', 'embed/');
            return `<section class="body-video-section"><div class="video-wrapper"><iframe src="${embedUrl}" title="${work.title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div></section>`;
          },
        },
        block: {
          normal: ({ children }: { children?: string }) => `<p>${children ?? ''}</p>`,
          h2: ({ children }: { children?: string }) => `<h2>${children ?? ''}</h2>`,
          h3: ({ children }: { children?: string }) => `<h3>${children ?? ''}</h3>`,
        },
        marks: {
          link: ({ children, value }: { children: string; value?: any }) =>
            `<a href="${value?.href}" target="_blank" rel="noopener noreferrer">${children}</a>`,
        },
      },
    })
  : '';
---

<Layout title={title}>
  <!-- Hero Section -->
  <section class="hero-section" style={`background-image: url('${heroImageUrl}');`}>
    <div class="hero-overlay"></div>
    <h1 class="hero-title">{work.title}</h1>

    {work.videoUrl ? (
      <div class="video-container">
        <div class="video-wrapper">
          <iframe
            src={work.videoUrl.replace('watch?v=', 'embed/')}
            title={work.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    ) : (
      <div class="hero-content">
        <div class="video-container">
          <img
            src={urlFor(work.coverImage).width(1000).url()}
            alt={work.title}
            class="hero-image"
          />
        </div>
        {work.heroDescription && (
          <div class="hero-text-container">
            <p class="hero-description">{work.heroDescription}</p>
          </div>
        )}
      </div>
    )}
  </section>

  <!-- Collaborators Section -->
  {work.collaborators && work.collaborators.length > 0 && (
    <section class="collaborators-section">
      <p class="collaborators-text">
        In Collaboration with: {
          work.collaborators.map((collab, index) => (
            <>
              {collab.url ? (
                <a href={collab.url} target="_blank" rel="noopener noreferrer" class="collaborator-link">
                  {collab.name}
                </a>
              ) : (
                <span>{collab.name}</span>
              )}
              {index < work.collaborators!.length - 1 && ', '}
            </>
          ))
        }
      </p>
    </section>
  )}

  <!-- Body: text blocks, images, video embeds — in the order you set in Sanity -->
  {bodyHtml && (
    <div class="body-content" set:html={bodyHtml} />
  )}

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <div class="lightbox-stage">
      <img class="lightbox-image" alt="" />
    </div>
    <div class="lightbox-hint">scroll to zoom &middot; drag to pan &middot; esc to close</div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.image-gallery').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-slide'));
    const counter = gallery.querySelector<HTMLElement>('.gallery-current');
    const prev = gallery.querySelector<HTMLButtonElement>('.gallery-prev');
    const next = gallery.querySelector<HTMLButtonElement>('.gallery-next');
    if (slides.length === 0) return;
    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.toggleAttribute('hidden', idx !== current));
      if (counter) counter.textContent = String(current + 1);
    };
    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    gallery.tabIndex = 0;
    gallery.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });
  });

  // Lightbox with mouse-wheel zoom and drag-to-pan
  (() => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
    const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
    if (!lightbox || !lightboxImg || !closeBtn) return;

    const MIN_SCALE = 1;
    const MAX_SCALE = 8;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let dragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartTx = 0;
    let dragStartTy = 0;

    const apply = () => {
      lightboxImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    };
    const reset = () => {
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    };
    const open = (src: string, alt: string) => {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      reset();
      lightbox.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.setAttribute('hidden', '');
      lightboxImg.src = '';
      document.body.style.overflow = '';
      reset();
    };

    document.querySelectorAll<HTMLElement>('.gallery-slide').forEach((slide) => {
      slide.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.gallery-btn')) return;
        const img = slide.querySelector<HTMLImageElement>('img');
        if (img) open(img.src, img.alt);
      });
    });

    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-stage')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hasAttribute('hidden')) return;
      if (e.key === 'Escape') close();
    });

    lightbox.addEventListener('wheel', (e) => {
      if (lightbox.hasAttribute('hidden')) return;
      e.preventDefault();
      const rect = lightboxImg.getBoundingClientRect();
      const cx = e.clientX - (rect.left + rect.width / 2);
      const cy = e.clientY - (rect.top + rect.height / 2);
      const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
      const next = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale * factor));
      const ratio = next / scale;
      tx = cx - (cx - tx) * ratio;
      ty = cy - (cy - ty) * ratio;
      scale = next;
      if (scale === 1) { tx = 0; ty = 0; }
      apply();
    }, { passive: false });

    lightboxImg.addEventListener('mousedown', (e) => {
      if (scale === 1) return;
      dragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragStartTx = tx;
      dragStartTy = ty;
      lightboxImg.style.cursor = 'grabbing';
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      tx = dragStartTx + (e.clientX - dragStartX);
      ty = dragStartTy + (e.clientY - dragStartY);
      apply();
    });
    window.addEventListener('mouseup', () => {
      dragging = false;
      lightboxImg.style.cursor = '';
    });
  })();
</script>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 100vh;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 15vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: rgba(0, 0, 0, 0.4);
  }

  .hero-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, #111111);
    pointer-events: none;
    z-index: 1;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    font-size: 4rem;
    font-weight: 300;
    text-align: center;
    color: white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .video-container {
    position: relative;
    z-index: 2;
    width: 65vw;
    max-width: 1000px;
    margin-top: 5vh;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 65vw;
    max-width: 1000px;
    margin-top: 5vh;
    display: flex;
    flex-direction: column;
    gap: 3vh;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-text-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-description {
    font-size: 1.5rem;
    line-height: 1.8;
    color: white;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  /* Collaborators Section */
  .collaborators-section {
    width: 100%;
    max-width: 800px;
    margin: 3rem auto 2rem;
    padding: 0 2rem;
  }

  .collaborators-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
  }

  .collaborator-link {
    color: #fbbf24;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .collaborator-link:hover {
    color: #fcd34d;
    text-decoration: underline;
  }

  /* Body content */
  .body-content {
    width: 100%;
  }

  /* Text blocks (rendered from Portable Text) */
  .body-content :global(p),
  .body-content :global(h2),
  .body-content :global(h3) {
    max-width: 800px;
    margin: 0 auto 1.5rem;
    padding: 0 2rem;
    line-height: 1.8;
  }

  .body-content :global(p) {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .body-content :global(h2) {
    font-size: 2rem;
    font-weight: 400;
    margin-top: 3rem;
  }

  .body-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 400;
    margin-top: 2rem;
  }

  .body-content :global(a) {
    color: #fbbf24;
    text-decoration: underline;
  }

  .body-content :global(a:hover) {
    color: #fcd34d;
  }

  /* Image blocks */
  .body-content :global(.fullwidth-image-section) {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .body-content :global(figure) {
    width: 100%;
    max-width: 800px;
    margin: 0;
  }

  .body-content :global(.fullwidth-image) {
    width: 100%;
    height: auto;
    display: block;
  }

  .body-content :global(.image-caption) {
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  /* Image gallery */
  .body-content :global(.gallery-section) {
    margin: 2rem 0;
  }

  .body-content :global(.image-gallery) {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    outline: none;
    display: grid;
    grid-template-columns: 3rem 1fr 3rem;
    align-items: center;
    gap: 1rem;
  }

  .body-content :global(.gallery-slides) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .body-content :global(.gallery-slide) {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
  }

  .body-content :global(.gallery-slide[hidden]) {
    display: none;
  }

  .body-content :global(.gallery-slide .fullwidth-image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .body-content :global(.gallery-slide .image-caption) {
    position: absolute;
    bottom: 0.5rem;
    left: 0;
    right: 0;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    background: rgba(0, 0, 0, 0.4);
    padding: 0.4rem 0.75rem;
  }

  .body-content :global(.gallery-btn) {
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .body-content :global(.gallery-btn:hover) {
    background: rgba(0, 0, 0, 0.8);
  }

  .body-content :global(.gallery-counter) {
    grid-column: 1 / -1;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] { display: none; }

  .lightbox-stage {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lightbox-image {
    max-width: 95vw;
    max-height: 95vh;
    transform-origin: center center;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    will-change: transform;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .lightbox-close:hover { background: rgba(255, 255, 255, 0.2); }

  .lightbox-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    right: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    pointer-events: none;
  }

  /* Video embeds in body */
  .body-content :global(.body-video-section) {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .body-content :global(.body-video-section .video-wrapper) {
    width: 65vw;
    max-width: 1000px;
    position: relative;
    padding-bottom: 56.25%;
  }

  .body-content :global(.body-video-section .video-wrapper iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title { font-size: 2.5rem; }
    .video-container { width: 90vw; }
    .hero-content { width: 90vw; }
    .hero-description { font-size: 1.2rem; }
    .body-content :global(p) { font-size: 1rem; }
    .body-content :global(h2) { font-size: 1.5rem; }
    .body-content :global(h3) { font-size: 1.25rem; }
    .body-content :global(figure) { width: 100%; }
    .body-content :global(.body-video-section .video-wrapper) { width: 90vw; }
  }
</style>
