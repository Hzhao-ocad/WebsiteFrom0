---
import Layout from "../../layouts/layout.astro";
import { getAllWorks } from "../../lib/queries";
import { urlFor } from "../../lib/sanityClient";

const title = "Works — Harry Zhao | Robotics & Interactive Art";
const description = "Selected projects by Harry Zhao spanning physical computing, robotics, interactive installation, animation, and digital media.";
const works = await getAllWorks();

const featuredTags = [
  "Physical Computing",
  "Animation",
  "Sculpture",
  "Interactive",
  "Game",
  "3D"
];
---

<Layout title={title} description={description}>
  <section class="page-header">
    <div class="container">
      <h1>Works</h1>
      <p class="page-subtitle">Robotics, physical computing &amp; interactive art by Harry Zhao</p>
    </div>
  </section>

  <section class="tag-filter">
    <div class="tag-filter-container">
      <button class="filter-tag active" data-tag="all">All</button>
      {featuredTags.map(tag => (
        <button class="filter-tag" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </section>

  <section class="works-section">
    <div class="works-grid">
      {works.map(work => (
        <a href={`/works/${work.slug.current}`} class="work-card" data-tags={JSON.stringify(work.tags || [])}>
          <div class="work-image-wrapper">
            <img
              src={urlFor(work.coverImage).width(800).height(500).fit('crop').url()}
              srcset={`${urlFor(work.coverImage).width(400).height(250).fit('crop').auto('format').url()} 400w, ${urlFor(work.coverImage).width(800).height(500).fit('crop').auto('format').url()} 800w, ${urlFor(work.coverImage).width(1200).height(750).fit('crop').auto('format').url()} 1200w`}
              sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt={`${work.title} — work by Harry Zhao`}
              class="work-image"
              loading="lazy"
              width="800"
              height="500"
            />
            {work.previewVideoUrl && (
              <video width="600" muted loop autoplay preload="none">
                <source src={work.previewVideoUrl} type="video/webm" />
              </video>
            )}
            <div class="work-overlay">
              <h3 class="work-title">{work.title}</h3>
              <p class="work-description">{work.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 4rem 2rem 2rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    margin: 0;
  }

  .works-section {
    padding: 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .works-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .works-grid { grid-template-columns: 1fr; }
  }

  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .work-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .work-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .work-image {
    transform: scale(1.05);
  }

  .work-image-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .work-card:hover video {
    opacity: 1;
  }

  .work-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .work-card:hover .work-overlay {
    opacity: 1;
  }

  .work-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    color: #fff;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .work-card:hover .work-title {
    transform: translateY(0);
    opacity: 1;
  }

  .work-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    line-height: 1.5;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.4s ease 0.05s, opacity 0.4s ease 0.05s;
  }

  .work-card:hover .work-description {
    transform: translateY(0);
    opacity: 1;
  }

  .tag-filter {
    padding: 0 2rem;
    margin-bottom: 1rem;
  }

  .tag-filter-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  .filter-tag {
    font-size: 0.9rem;
    padding: 0;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .filter-tag:hover {
    color: #fbbf24;
    text-decoration: underline;
  }

  .filter-tag.active {
    color: #fff;
    text-decoration: underline;
  }

  .work-card.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-tag');
    const workCards = document.querySelectorAll('.work-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const selectedTag = button.getAttribute('data-tag');

        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        workCards.forEach(card => {
          if (selectedTag === 'all') {
            card.classList.remove('hidden');
          } else {
            const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
            if (cardTags.includes(selectedTag)) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });
      });
    });
  });
</script>
